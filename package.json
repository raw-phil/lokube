{
  "name": "lokube",
  "version": "1.0.0",
  "type": "module",
  "description": "CLI tool to test and run Kubernetes microservices locally with port-forwarded dependencies",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lokube": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "npm run build && node dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint:tsc": "tsc --noEmit --pretty"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}